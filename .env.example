# --- Airflow ---------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_IMAGE_NAME=flight-price-analysis-airflow:3.4.0
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me

# --- MySQL (staging) -------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=flight_staging
MYSQL_USER=airflow
MYSQL_PASSWORD=airflow

# --- PostgreSQL (shared Airflow metadata + analytics database) -------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- Airflow connections (used by scripts/setup_connections.sh) ------------
MYSQL_CONN_HOST=mariadb
MYSQL_CONN_PORT=3306
PG_CONN_HOST=postgres
PG_CONN_PORT=5432

# --- Pipeline --------------------------------------------------------------
MAX_REJECTED_RATIO=0.05

# --- Failure alerts (Gmail) ------------------------------------------------
# Create an app password at https://myaccount.google.com/apppasswords (needs 2-step verification).
# Leave ALERT_EMAIL empty to turn alerts off. Several addresses: a@x.com,b@y.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL=
TASK_RETRIES=2
TASK_RETRY_DELAY_MINUTES=2

# --- Spark -----------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=4